# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# --- dependencies & build output -------------------------------------------
/node_modules
/.next/
/out/
*.tsbuildinfo
# regenerated by next build
next-env.d.ts

# --- generated at build time ------------------------------------------------
# scripts/copy-ort.mjs stages these from node_modules on prebuild (~40 MB).
# Never commit them: they must match the installed onnxruntime-web version.
/public/ort/

# --- env & platform ---------------------------------------------------------
.env*
.vercel
.DS_Store
*.pem

# --- logs -------------------------------------------------------------------
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# --- ml working files -------------------------------------------------------
ml/.venv/
# export_onnx.py output; the shipped copy is public/models/best.onnx
ml/best.onnx
# throwaway clips used while testing the frame loop
ml/test_synthetic.*
# probe outputs; the committed copies live in evidence/
ml/parity_python.json
ml/parity_web.json
ml/parity_footage.json

# --- tooling scratch --------------------------------------------------------
.playwright-mcp/
# regenerated by `next dev` on every run
AGENTS.md
CLAUDE.md

# evaluated alternative checkpoint - see evidence/model_comparison/
ml/better.pt
ml/better.onnx
ml/model_comparison.json
ml/cmp_*.jpg
